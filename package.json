{
  "name": "@nationdex/db",
  "version": "1.1.0",
  "description": "Bun database extension for Project Nationdex 2026, backed by embedded PGlite.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "author": "nationdex",
  "license": "GPL-3.0",
  "scripts": {
    "build": "bun build --target=bun --no-bundle --root=src --outdir=dist src/index.ts src/events/*.ts src/functions/*/*.ts src/structures/*.ts src/util/*.ts",
    "test": "bun test src",
    "typecheck": "bun check",
    "metadata": "bun run build && bun scripts/generate-metadata.ts"
  },
  "files": [
    "dist",
    "src",
    "metadata"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nationdex/db.git"
  },
  "bugs": {
    "url": "https://github.com/nationdex/db/issues"
  },
  "homepage": "https://github.com/nationdex/db#readme",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devDependencies": {
    "@tryforge/forgescript": "github:tryforge/ForgeScript#3cb23c6",
    "@types/bun": "^1.4.4"
  },
  "dependencies": {
    "@electric-sql/pglite": "~0.5.17"
  },
  "peerDependencies": {
    "@tryforge/forgescript": "^2.8.0"
  }
}
