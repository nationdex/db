{
  "name": "@nationdex/db",
  "version": "2.1.1",
  "description": "Easy to use database for ForgeScript.",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "docgen": "tsc && typedoc src/index.ts && node dist/docgen",
    "commit": "npm run docgen && node dist/commit",
    "format": "biome format --write ./src",
    "lint": "biome lint --write ./src",
    "check": "biome check ./src",
    "test": "tsc && node dist/__tests__/runner.js"
  },
  "keywords": [
    "bdfd",
    "aoi.js",
    "aoi",
    "dbd",
    "dbd.ts",
    "dbd.js",
    "easy",
    "fast",
    "efficient",
    "bdscript",
    "database",
    "db",
    "surrealdb",
    "surrealkv"
  ],
  "author": "aggelos007",
  "license": "GPL-3.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tryforge/forgescript": "github:tryforge/ForgeScript#dev",
    "@types/node": "^20.19.43",
    "discord.js": "^14.27.0",
    "mongodb": "^6.21.0",
    "sqlite3": "^6.0.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nationdex/db.git"
  },
  "bugs": {
    "url": "https://github.com/nationdex/db/issues"
  },
  "homepage": "https://github.com/nationdex/db#readme",
  "engines": {
    "node": ">=16.11.0"
  },
  "dependencies": {
    "tiny-typed-emitter": "^2.1.0",
    "typeorm": "^0.3.31"
  },
  "optionalDependencies": {
    "@surrealdb/node": "^2.0.0",
    "surrealdb": "^2.0.8"
  },
  "peerDependencies": {
    "@surrealdb/node": "^2.0.0",
    "better-sqlite3": "*",
    "mongodb": "^6.19.0",
    "mysql2": "*",
    "pg": "*",
    "sqlite3": "^5.1.7 || ^6.0.1",
    "surrealdb": "^2.0.8"
  },
  "peerDependenciesMeta": {
    "sqlite3": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "surrealdb": {
      "optional": true
    },
    "@surrealdb/node": {
      "optional": true
    }
  }
}